# Postgres connection (driver: postgres)
DATABASE_URL=postgresql://turbine:turbine_dev@localhost:5432/turbine_turmweg

# JWT signing key (HS256). Generate with: openssl rand -hex 32
SECRET_KEY=replace-me-with-a-32-byte-hex-string

# Strava OAuth (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Anthropic Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Public base URL the app is reachable at (used for Strava redirect URI)
BASE_URL=http://localhost:3000

# Platform admins, comma-separated. Anyone listed here can reach /admin without
# a database flag — this is how the first admin is bootstrapped.
ADMIN_EMAILS=
